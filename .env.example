# ==============================================================================
# OWRADIO - Open Web Radio & Discord Audio Engine
# Environment Configuration Template
# Optimized for Oracle Cloud Infrastructure (OCI) Always Free Tier
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Web Server & Audio Broadcast
# ------------------------------------------------------------------------------
# Port for the embedded Hono HTTP server (serves web dashboard, SSE, and stream)
WEB_PORT=8091

# Optional Public Domain or HTTPS URL (e.g. https://myradio.duckdns.org)
# Set automatically when using Caddy + DuckDNS, or specify your custom domain
PUBLIC_URL=

# Mount path for the live continuous MP3 audio broadcast
STREAM_MOUNT=/stream.mp3

# Constant MP3 streaming bitrate in kbps (128, 192, 256, 320)
STREAM_BITRATE_KBPS=192

# SQLite database file path (stores play history, user preferences, taste DNA)
DATABASE_PATH=./data/owradio.sqlite

# ------------------------------------------------------------------------------
# 2. Discord Bot Integration (OPTIONAL)
# Leave DISCORD_TOKEN empty to run OWRadio in Standalone Web Radio Mode!
# ------------------------------------------------------------------------------
# Discord Bot Application Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Discord Application Client ID
DISCORD_CLIENT_ID=

# Primary Discord Guild/Server ID (for instant slash command registration)
DISCORD_GUILD_ID=

# Default Discord Voice Channel ID to auto-join and auto-resume on startup
DEFAULT_VOICE_CHANNEL_ID=

# Default Discord Text Channel ID for the auto-updating Now Playing player UI
DEFAULT_TEXT_CHANNEL_ID=

# ------------------------------------------------------------------------------
# 3. Double Authentication System
# Granular permission model: Song search & "+ Queue" remain 100% public to all!
# Skip, pause, stop, volume, and configuration settings are locked behind auth.
# ------------------------------------------------------------------------------
# Master switch for authentication (true / false)
# If left empty, automatically enables if ADMIN_PASSWORD is provided below
AUTH_ENABLED=false

# Tier 1: Simple Admin Password for the Web Dashboard
ADMIN_PASSWORD=change_me_to_a_secure_admin_password

# Tier 2: Supabase Google OAuth Integration (Optional)
# Obtain these from your Supabase Project Settings -> API & Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Secret key used for signing session cookies (auto-generated if omitted)
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 4. Music Intelligence & Discovery
# Powered by Deezer, MusicBrainz, YouTube Music & YouTube (Zero-AI, lightweight)

# ------------------------------------------------------------------------------
# 5. Audio Pipeline & Pre-Buffering Decks
# ------------------------------------------------------------------------------
# Number of upcoming songs pre-buffered in RAM for zero-latency, gapless playback
STANDBY_DECKS_COUNT=3

# Hours before an already-played song can be auto-curated again
AUTOPLAY_COOLDOWN_HOURS=48

# Hours before the same artist can be auto-curated again
ARTIST_COOLDOWN_HOURS=2

# Maximum song duration allowed in seconds (e.g. 7200 = 2 hours)
MAX_SONG_DURATION_SEC=7200

# ------------------------------------------------------------------------------
# 6. YouTube Resolution & Cookie Bypassing (Optional)
# ------------------------------------------------------------------------------
# Path to Netscape-format cookies.txt to bypass YouTube bot detection/rate limits
YOUTUBE_COOKIES_PATH=./cookies.txt
