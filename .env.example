# ==============================================================================
# OWRADIO - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Discord Bot (Optional - leave empty for Standalone Web Radio mode)
# ------------------------------------------------------------------------------
# Get your token from: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Your Discord Server (Guild) ID for 0-second instant slash command registration
DISCORD_GUILD_ID=

# ------------------------------------------------------------------------------
# 2. Web Radio & Studio Dashboard
# ------------------------------------------------------------------------------
# Port for the web interface and continuous /stream.mp3 audio broadcast
WEB_PORT=8091

# Admin password to protect Skip, Pause, and Volume controls on the web.
# Leave empty to allow all visitors open access!
ADMIN_PASSWORD=

# Optional public domain or HTTPS URL (e.g. https://myradio.duckdns.org)
PUBLIC_URL=

# ------------------------------------------------------------------------------
# 3. YouTube Music Cookies (Optional)
# ------------------------------------------------------------------------------
# If hosting on a cloud server/VPS, YouTube might block music playback with bot checks.
# Export cookies.txt from youtube.com using the "Get cookies.txt LOCALLY" extension:
YOUTUBE_COOKIES_PATH=./cookies.txt
