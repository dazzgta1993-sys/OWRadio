# ==============================================================================
# OWRADIO DOCKER - Environment Configuration Template
# ==============================================================================

# 1. Core Web Server & Audio Broadcast
WEB_PORT=8091
PUBLIC_URL=
STREAM_MOUNT=/stream.mp3
STREAM_BITRATE_KBPS=192
DATABASE_PATH=/app/data/owradio.db
NODE_ENV=production

# 2. Discord Bot Integration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DEFAULT_GUILD_ID=your_discord_guild_id_here
DEFAULT_VOICE_CHANNEL_ID=your_default_voice_channel_id_here

# 3. Spotify Metadata & Link Resolution
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# 4. Double Authentication System
AUTH_ENABLED=true
ADMIN_PASSWORD=change_this_admin_password
SESSION_SECRET=change_this_random_session_secret_32_chars

# 5. Curation Engine Architecture
# 'hybrid' (Collaborative Graph + Fast Latent Vector Similarity), 'embedding', 'jev', or 'llm'
CURATION_ENGINE=hybrid
STANDBY_DECKS_COUNT=3
AUTOPLAY_COOLDOWN_HOURS=48
ARTIST_COOLDOWN_HOURS=2
MAX_SONG_DURATION_SEC=7200

# 6. YouTube Anti-Bot & Outbound Proxy (Optional)
# YOUTUBE_PROXY=http://100.64.0.1:8888
YOUTUBE_COOKIES_PATH=/app/data/youtube-cookies.txt
